# The canonical production origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Public Google Calendar appointment-schedule URL from its sharing options.
NEXT_PUBLIC_GOOGLE_CALENDAR_SCHEDULING_URL=https://calendar.google.com/calendar/appointments/schedules/your-schedule-id

# Private Discord webhook for anonymous website messages.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token

# Public PostHog project key and ingestion host. Analytics is disabled entirely
# when either is missing or malformed: no scripts load and no requests are made.
# Setting these also enables the /ingest reverse proxy in next.config.ts.
# Leave them unset locally unless you are specifically testing analytics —
# tests/e2e/site.spec.ts asserts a clean console, so a blocked or misconfigured
# PostHog request will fail that suite.
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Google Analytics 4 measurement id. Google Analytics is skipped when this is
# missing or does not look like a measurement id.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
