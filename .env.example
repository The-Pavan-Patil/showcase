# The canonical production origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Public Google Calendar appointment-schedule URL from:
# Sharing options > Website embed > A single booking page > Button with popup.
NEXT_PUBLIC_GOOGLE_CALENDAR_SCHEDULING_URL=https://calendar.google.com/calendar/appointments/schedules/your-schedule-id

# Private Discord webhook for anonymous website messages.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token
